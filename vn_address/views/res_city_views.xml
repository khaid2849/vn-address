<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_city_vn_list" model="ir.ui.view">
        <field name="name">res.city.vn.list</field>
        <field name="model">res.city</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Communes / Wards">
                <header>
                    <button
                        name="action_vn_sync"
                        type="object"
                        string="Sync from AddressKit"
                        display="always"
                        groups="base.group_system"
                        icon="fa-refresh"
                    />
                </header>
                <field name="vn_code" />
                <field name="name" />
                <field name="vn_level" />
                <field name="state_id" />
                <field name="zipcode" optional="hide" />
                <field name="vn_decree" optional="hide" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="res_city_vn_form" model="ir.ui.view">
        <field name="name">res.city.vn.form</field>
        <field name="model">res.city</field>
        <field name="arch" type="xml">
            <form string="Commune / Ward">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="vn_code" />
                            <field name="vn_level" />
                            <field name="active" invisible="1" />
                        </group>
                        <group>
                            <field name="state_id" />
                            <field name="country_id" />
                            <field name="zipcode" />
                            <field name="vn_decree" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_city_search_vn" model="ir.ui.view">
        <field name="name">res.city.search.vn</field>
        <field name="model">res.city</field>
        <field name="inherit_id" ref="base_address_extended.view_city_filter" />
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', '|', ('name', 'ilike', self), ('zipcode', 'ilike', self), ('vn_code', '=like', self + '%')]</attribute>
            </field>
            <field name="country_id" position="after">
                <field name="state_id" />
                <filter name="level_ward" string="Wards" domain="[('vn_level', '=', 'ward')]" />
                <filter name="level_commune" string="Communes" domain="[('vn_level', '=', 'commune')]" />
                <filter name="level_special_zone" string="Special Zones" domain="[('vn_level', '=', 'special_zone')]" />
                <separator />
                <filter name="archived" string="Archived" domain="[('active', '=', False)]" />
                <group name="group_by">
                    <filter name="group_state" string="Province" context="{'group_by': 'state_id'}" />
                    <filter name="group_level" string="Administrative Level" context="{'group_by': 'vn_level'}" />
                </group>
            </field>
        </field>
    </record>

    <record id="action_res_city_vn" model="ir.actions.act_window">
        <field name="name">Vietnam: Communes / Wards</field>
        <field name="res_model">res.city</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('country_id', '=', ref('base.vn'))]" />
        <field name="context" eval="{'default_country_id': ref('base.vn')}" />
        <field
            name="view_ids"
            eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('res_city_vn_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('res_city_vn_form')})]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No administrative units yet</p>
            <p>Use "Sync from AddressKit" to load the communes, wards and special zones of Vietnam.</p>
        </field>
    </record>

    <menuitem
        id="menu_res_city_vn"
        action="action_res_city_vn"
        parent="contacts.menu_localisation"
        sequence="3"
    />
</odoo>
