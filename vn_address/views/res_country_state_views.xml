<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_country_state_tree_vn" model="ir.ui.view">
        <field name="name">res.country.state.list.vn</field>
        <field name="model">res.country.state</field>
        <field name="inherit_id" ref="base.view_country_state_tree" />
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="vn_code" optional="show" />
                <field name="vn_level" optional="show" />
            </field>
        </field>
    </record>

    <record id="view_country_state_form_vn" model="ir.ui.view">
        <field name="name">res.country.state.form.vn</field>
        <field name="model">res.country.state</field>
        <field name="inherit_id" ref="base.view_country_state_form" />
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="vn_code" />
                <field name="vn_level" />
            </field>
        </field>
    </record>
</odoo>
